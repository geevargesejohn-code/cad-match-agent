# Copy this file to .env and fill in only what you use.
# With no key at all the agent still works, using score-only verdicts.

# Which vision LLM judges the final match: none | anthropic | openai | ollama
CAD_MATCH_LLM_PROVIDER=none

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional: store library, cache and database somewhere else
# CAD_MATCH_DATA_DIR=/absolute/path/to/data
